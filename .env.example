# PostgreSQL de origem
POSTGRES_HOST=<ip-ou-hostname-do-computador-do-postgresql>
POSTGRES_PORT=<porta-do-postgresql>
POSTGRES_USER=<usuario-do-postgresql>
POSTGRES_PASSWORD=<senha-do-postgresql>

# Google Cloud
GCP_PROJECT_ID=botbrewpub-ghsurp
GCS_BUCKET=<nome-do-bucket-bronze>
GCS_BRONZE_PREFIX=bronze/parquet
